# Replace placeholders in a private .env. Do not commit credentials.
AZURE_SUBSCRIPTION_ID=<YOUR_SUBSCRIPTION_ID>
AZURE_TENANT_ID=<YOUR_TENANT_ID>
AZURE_LOCATION=eastus2
FOUNDRY_RESOURCE_GROUP=<YOUR_FOUNDRY_RESOURCE_GROUP>
FOUNDRY_ACCOUNT_NAME=<YOUR_FOUNDRY_RESOURCE>
FOUNDRY_PROJECT_NAME=<YOUR_FOUNDRY_PROJECT>
FOUNDRY_PROJECT_ENDPOINT=https://<YOUR_FOUNDRY_RESOURCE>.services.ai.azure.com/api/projects/<YOUR_FOUNDRY_PROJECT>
FOUNDRY_OPENAI_BASE_URL=https://<YOUR_FOUNDRY_RESOURCE>.openai.azure.com/openai/v1/
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.4-mini
FOUNDRY_API_MODE=chat_completions
FOUNDRY_TOKEN_SCOPE=https://ai.azure.com/.default
DYNAMIC_SESSIONS_RESOURCE_GROUP=
DYNAMIC_SESSIONS_POOL_ENDPOINT=
DYNAMIC_SESSIONS_WIRE_PROFILE=containerapp-1.3.0b5
DYNAMIC_SESSIONS_API_VERSION=2025-10-02-preview
DYNAMIC_SESSIONS_TOKEN_SCOPE=https://dynamicsessions.io/.default
SANDBOX_RESOURCE_GROUP=
SANDBOX_GROUP_NAME=
SANDBOX_ENDPOINT=
SANDBOX_API_VERSION=2026-02-01-preview
SANDBOX_ARM_API_VERSION=2026-07-01
SANDBOX_TOKEN_SCOPE=https://dynamicsessions.io/.default
ENABLE_LIVE_AZURE=false
ENABLE_PROVISIONING=false
